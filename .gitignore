# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local manual originals and extracts (do not commit binaries)
/data/manual-store/**
!/data/manual-store/official/
!/data/manual-store/official/2025-eval-manual.pdf
!/data/manual-store/preview.json
/data/workflows/
/test-runs/
*.traineddata

# vercel
.vercel
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

pack-deploy.mjs
fix-deploy.mjs
deploy-files.json
deploy-core.json
deploy-small.json
